# Copy to .env and fill in. Never commit .env.
DOMAIN=guardian.example.com
ENVIRONMENT=production          # use "staging" on the test server
# generate both with: openssl rand -hex 32
DB_PASSWORD=
SECRET_KEY=
ACCESS_TOKEN_MINUTES=1440
RETENTION_DAYS=30

# Optional monitoring (see MONITORING.md)
SENTRY_DSN=
ALERT_URL=                      # e.g. https://ntfy.sh/a-long-random-topic-name
