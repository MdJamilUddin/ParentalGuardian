# Normalise line endings. Scripts and Docker files MUST stay LF or they break on the Linux server
# (Windows Git would otherwise convert them to CRLF).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
crontab.example text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
